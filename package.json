{
  "name": "eslint-plugin-prototype-pollution",
  "version": "1.0.0",
  "description": "Detect the use of prototype pollution vulnerabilities",
  "homepage": "https://github.com/shoham-utila/eslint-plugin-prototype-pollution",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shoham-utila/eslint-plugin-prototype-pollution.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "prototype-pollution"
  ],
  "author": "bsShoham",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "lib",
    "types",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "npm-run-all \"lint:*\"",
    "lint:eslint-docs": "npm-run-all \"update:eslint-docs -- --check\"",
    "lint:js": "eslint .",
    "lint:types": "tsc --noEmit --project tests/types/tsconfig.json",
    "test": "npm-run-all \"test:*\"",
    "test:eslint9": "cross-env ESLINT_PKG=eslint9 mocha tests --recursive",
    "test:eslint10": "mocha tests --recursive",
    "update:eslint-docs": "eslint-doc-generator",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-doc-generator": "^3.7.0",
    "eslint-plugin-eslint-plugin": "^7.6.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint9": "npm:eslint@^9.39.5",
    "globals": "^17.9.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "license": "MIT"
}
