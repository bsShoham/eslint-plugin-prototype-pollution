{
  "name": "eslint-plugin-prototype-pollution",
  "version": "0.2.0",
  "description": "Detect the use of prototype pollution vulnerabilities",
  "homepage": "https://github.com/shoham-utila/eslint-plugin-prototype-pollution",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shoham-utila/eslint-plugin-prototype-pollution.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "prototype-pollution"
  ],
  "author": "bsShoham",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "lib",
    "types",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "npm-run-all \"lint:*\"",
    "lint:eslint-docs": "npm-run-all \"update:eslint-docs -- --check\"",
    "lint:js": "eslint .",
    "lint:types": "tsc --noEmit --project tests/types/tsconfig.json",
    "test": "npm-run-all \"test:*\"",
    "test:eslint9": "mocha tests --recursive",
    "test:eslint8": "cross-env ESLINT_PKG=eslint8 mocha tests --recursive",
    "test:eslint10": "cross-env ESLINT_PKG=eslint10 mocha tests --recursive",
    "update:eslint-docs": "eslint-doc-generator"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-doc-generator": "^1.7.1",
    "eslint-plugin-eslint-plugin": "^6.2.0",
    "eslint-plugin-n": "^17.10.2",
    "eslint10": "npm:eslint@^10.8.0",
    "eslint8": "npm:eslint@^8.57.1",
    "espree": "^10.1.0",
    "globals": "^15.15.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^14.17.0 || ^16.0.0 || >= 18.0.0"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "license": "MIT"
}
